# ==============================================================================
# ImpeccableOS - Environment Configuration Blueprint
# Copy this file to .env and supply actual keys before running services
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ImpeccableOS
PROJECT_VERSION=1.0.0

# ------------------------------------------------------------------------------
# Backend Service (FastAPI)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change_this_to_a_cryptographically_secure_random_hex_key_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# PostgreSQL 16 + pgvector Database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=impeccable_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/impeccable_os
SYNC_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/impeccable_os

# ------------------------------------------------------------------------------
# LLM Providers & Embeddings
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PRIMARY_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Web Research & Reranking Engines
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-api-key-here
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_FALLBACK_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# Frontend Application (Next.js 14)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ImpeccableOS
