# ==============================================================================
# ImpeccableOS - Production Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
[Nn]on[Dd]istributable

# ------------------------------------------------------------------------------
# IDEs, Editors & Developer Tools
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key
*.cert
*.crt
credentials.json
service_account.json

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter Notebooks & Profiling
.ipynb_checkpoints
*.prof

# ------------------------------------------------------------------------------
# Node.js, Next.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store

# Next.js Build Artifacts
.next/
out/
.turbo/
.vercel/

# TypeScript & Linter Caches
*.tsbuildinfo
.eslintcache
.stylelintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Databases, Vector Stores & Local Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.lance
*.parquet
pgdata/
data/postgres/
chroma_db/
qdrant_storage/

# ------------------------------------------------------------------------------
# AI Models, Weights & Embeddings Cache
# ------------------------------------------------------------------------------
models/
hf_cache/
*.safetensors
*.bin
*.pt
*.onnx
*.onnx_data
